# Keycloak OIDC
# Realm: esteemed-colleagues (shared across all Esteemed apps)
KEYCLOAK_ISSUER=https://cauthprod.esteemed.io/realms/esteemed-colleagues
KEYCLOAK_CLIENT_ID=esteemed-web
KEYCLOAK_CLIENT_SECRET=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=

# Commerce provisioning
DO_API_TOKEN=
DOCR_REGISTRY=dockerhub
COMMERCE_MEDUSA_IMAGE=medusajs/medusa:latest
COMMERCE_MEDUSA_STOREFRONT_IMAGE=esteemed/medusa-nextjs-starter:latest
WOO_IMAGE=esteemed/woocommerce:latest
DRUPAL_IMAGE=esteemed/drupal-commerce:latest
COMMERCE_PROVISIONER_URL=
COMMERCE_PROVISIONER_TOKEN=
CREATE_CLOUD_CONSOLE_URL=

# Persistent CMS files for WooCommerce / Drupal Commerce
CMS_FILES_S3_BUCKET=
CMS_FILES_S3_REGION=nyc3
CMS_FILES_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
CMS_FILES_S3_ACCESS_KEY_ID=
CMS_FILES_S3_SECRET_ACCESS_KEY=
